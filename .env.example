# ──── MySQL ────
MYSQL_ROOT_PASSWORD=supersecret_root
MYSQL_DATABASE=itsm_db
MYSQL_USER=itsm_user
MYSQL_PASSWORD=itsm_password_123

# ──── Backend ────
SECRET_KEY=change-me-to-a-random-64-char-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost"]

# ──── Redis ────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ──── Database ────
DATABASE_URL=mysql+aiomysql://itsm_user:itsm_password_123@mysql:3306/itsm_db

# ──── Email (Phase 3) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=ITSM Platform <alerts@yourcompany.com>

# ──── MS Teams (Phase 3) ────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# ──── Frontend ────
VITE_API_URL=http://localhost:8000/api/v1
